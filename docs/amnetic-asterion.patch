diff --git a/src/main/java/com/meekdev/amnetic/client/render/ShaderPackCompatibility.java b/src/main/java/com/meekdev/amnetic/client/render/ShaderPackCompatibility.java
new file mode 100644
index 0000000..4b5c829
--- /dev/null
+++ b/src/main/java/com/meekdev/amnetic/client/render/ShaderPackCompatibility.java
@@ -0,0 +1,31 @@
+package com.meekdev.amnetic.client.render;
+
+import net.fabricmc.loader.api.FabricLoader;
+import java.lang.reflect.Method;
+
+/** Optional Iris API bridge; an installed but inactive shader loader needs no workaround. */
+public final class ShaderPackCompatibility {
+    private static final boolean INSTALLED = FabricLoader.getInstance().isModLoaded("iris");
+    private static final Method ACTIVE = findApi();
+    private ShaderPackCompatibility() {}
+
+    private static Method findApi() {
+        if (!INSTALLED) return null;
+        for (String name : new String[]{"net.irisshaders.iris.api.v0.IrisApi",
+                "net.coderbot.iris.api.v0.IrisApi"}) {
+            try { return Class.forName(name).getMethod("isShaderPackInUse"); }
+            catch (ReflectiveOperationException | LinkageError ignored) { }
+        }
+        return null;
+    }
+
+    public static boolean active() {
+        if (!INSTALLED) return false;
+        // Unknown Iris APIs retain the conservative framebuffer compatibility path.
+        if (ACTIVE == null) return true;
+        try {
+            Object api = ACTIVE.getDeclaringClass().getMethod("getInstance").invoke(null);
+            return (boolean) ACTIVE.invoke(api);
+        } catch (ReflectiveOperationException | LinkageError failure) { return true; }
+    }
+}
