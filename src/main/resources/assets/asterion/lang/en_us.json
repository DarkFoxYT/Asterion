{
  "quest.asterion.queen_beetle.petals.title": "Queen's Favor",
  "quest.asterion.queen_beetle.petals.hint": "Look among the overgrowth.",
  "quest.asterion.queen_beetle.petals.accepted": "Bring me %s tainted petals. In return, one of my runes is yours.",
  "quest.asterion.queen_beetle.petals.rewarded": "Keep the rune close. I have more work for a trusted visitor.",
  "quest.asterion.queen_beetle.nursery_bedding.title": "Nursery Bedding",
  "quest.asterion.queen_beetle.nursery_bedding.hint": "Gather moss from the maze.",
  "quest.asterion.queen_beetle.nursery_bedding.accepted": "My young need soft beds. Bring %s ancient moss blocks for the nursery.",
  "quest.asterion.queen_beetle.nursery_bedding.rewarded": "The stone will no longer chill their shells. Take these provisions.",
  "quest.asterion.queen_beetle.living_threads.title": "Living Threads",
  "quest.asterion.queen_beetle.living_threads.hint": "Gather Ancient Vines.",
  "quest.asterion.queen_beetle.living_threads.accepted": "The nursery hangs above the damp floor. Bring %s Ancient Vines to bind its cradles.",
  "quest.asterion.queen_beetle.living_threads.rewarded": "Strong roots make strong bonds. These emeralds are yours.",
  "quest.asterion.queen_beetle.royal_feast.title": "Royal Feast",
  "quest.asterion.queen_beetle.royal_feast.hint": "Cook vines on a campfire.",
  "quest.asterion.queen_beetle.royal_feast.accepted": "The brood has hatched hungry. Cook and bring %s Popped Ancient Vines.",
  "quest.asterion.queen_beetle.royal_feast.rewarded": "A full brood is a quiet brood. Carry this rune with my thanks.",
  "quest.asterion.queen_beetle.fallen_timber.title": "Fallen Timber",
  "quest.asterion.queen_beetle.fallen_timber.hint": "Harvest dead wood.",
  "quest.asterion.queen_beetle.fallen_timber.accepted": "The old supports are splintering. Bring %s dead wood blocks to replace them.",
  "quest.asterion.queen_beetle.fallen_timber.rewarded": "Even fallen trees can shelter new life. Take this iron.",
  "quest.asterion.queen_beetle.nursery_frames.title": "Nursery Frames",
  "quest.asterion.queen_beetle.nursery_frames.hint": "Craft dead wood planks.",
  "quest.asterion.queen_beetle.nursery_frames.accepted": "We need boards for the cradles. Bring %s dead wood planks, cut and ready.",
  "quest.asterion.queen_beetle.nursery_frames.rewarded": "The carpenters can begin. Your work deserves payment.",
  "quest.asterion.queen_beetle.leaf_canopies.title": "Leaf Canopies",
  "quest.asterion.queen_beetle.leaf_canopies.hint": "Use shears on ancient leaves.",
  "quest.asterion.queen_beetle.leaf_canopies.accepted": "My young cannot sleep beneath bare stone. Bring %s ancient leaf blocks for their canopies.",
  "quest.asterion.queen_beetle.leaf_canopies.rewarded": "Now the nursery will smell of the forest. Keep these shears.",
  "quest.asterion.queen_beetle.silken_cradles.title": "Silken Cradles",
  "quest.asterion.queen_beetle.silken_cradles.hint": "Collect string from webs.",
  "quest.asterion.queen_beetle.silken_cradles.accepted": "The smallest hatchlings slip through the vines. Bring %s string for finer cradles.",
  "quest.asterion.queen_beetle.silken_cradles.rewarded": "Not a single hatchling will fall. Take food for your journey.",
  "quest.asterion.queen_beetle.bone_supports.title": "Bone Supports",
  "quest.asterion.queen_beetle.bone_supports.hint": "Gather bones in the crypts.",
  "quest.asterion.queen_beetle.bone_supports.accepted": "The crypts leave much behind. Bring %s bones; we will make supports from them.",
  "quest.asterion.queen_beetle.bone_supports.rewarded": "What was abandoned now protects the living. Here is your reward.",
  "quest.asterion.queen_beetle.compost_keepers.title": "Compost Keepers",
  "quest.asterion.queen_beetle.compost_keepers.hint": "Collect rotten flesh.",
  "quest.asterion.queen_beetle.compost_keepers.accepted": "Our garden keepers waste nothing. Bring %s rotten flesh for their compost beds.",
  "quest.asterion.queen_beetle.compost_keepers.rewarded": "The gardens will flourish. Let this rune guard your return.",
  "quest.asterion.queen_beetle.fungal_gardens.title": "Fungal Gardens",
  "quest.asterion.queen_beetle.fungal_gardens.hint": "Find brown mushrooms.",
  "quest.asterion.queen_beetle.fungal_gardens.accepted": "Our food stores need a new crop. Bring %s brown mushrooms to seed the gardens.",
  "quest.asterion.queen_beetle.fungal_gardens.rewarded": "A little patience will turn these into a harvest. Eat well yourself.",
  "quest.asterion.queen_beetle.light_the_paths.title": "Light the Paths",
  "quest.asterion.queen_beetle.light_the_paths.hint": "Craft ordinary torches.",
  "quest.asterion.queen_beetle.light_the_paths.accepted": "My workers lose their way in the dark. Bring %s torches to mark their paths.",
  "quest.asterion.queen_beetle.light_the_paths.rewarded": "They will find their way home now. Take this iron for your tools.",
  "quest.asterion.queen_beetle.iron_braces.title": "Iron Braces",
  "quest.asterion.queen_beetle.iron_braces.hint": "Smelt or collect iron ingots.",
  "quest.asterion.queen_beetle.iron_braces.accepted": "Water has weakened our doors. Bring %s iron ingots for sturdy braces.",
  "quest.asterion.queen_beetle.iron_braces.rewarded": "The doors will hold. Accept these emeralds for your trouble.",
  "quest.asterion.queen_beetle.copper_channels.title": "Copper Channels",
  "quest.asterion.queen_beetle.copper_channels.hint": "Smelt or collect copper.",
  "quest.asterion.queen_beetle.copper_channels.accepted": "The gardens need drains before the next flood. Bring %s copper ingots for channels.",
  "quest.asterion.queen_beetle.copper_channels.rewarded": "You have spared us a drowned harvest. Our stores are open to you.",
  "quest.asterion.queen_beetle.gilded_shells.title": "Gilded Shells",
  "quest.asterion.queen_beetle.gilded_shells.hint": "Bring ordinary gold ingots.",
  "quest.asterion.queen_beetle.gilded_shells.accepted": "We honor the keepers who raised this brood. Bring %s gold ingots for their shell ornaments.",
  "quest.asterion.queen_beetle.gilded_shells.rewarded": "Their service will be remembered. May this rune remember yours.",
  "quest.asterion.queen_beetle.restore_the_court.title": "Restore the Court",
  "quest.asterion.queen_beetle.restore_the_court.hint": "Collect or craft ancient bricks.",
  "quest.asterion.queen_beetle.restore_the_court.accepted": "The court walls are crumbling. Bring %s ancient bricks to mend them.",
  "quest.asterion.queen_beetle.restore_the_court.rewarded": "You have returned a little dignity to this place. Take your payment.",
  "quest.asterion.queen_beetle.nursery_boundary.title": "Nursery Boundary",
  "quest.asterion.queen_beetle.nursery_boundary.hint": "Craft ancient stone walls.",
  "quest.asterion.queen_beetle.nursery_boundary.accepted": "The hatchlings wander too far. Bring %s ancient stone walls for a nursery boundary.",
  "quest.asterion.queen_beetle.nursery_boundary.rewarded": "A boundary, not a prison. They will be safe until their shells harden.",
  "quest.asterion.queen_beetle.green_watchfires.title": "Lantern Watch",
  "quest.asterion.queen_beetle.green_watchfires.hint": "Craft lanterns from iron and torches.",
  "quest.asterion.queen_beetle.green_watchfires.accepted": "The outer paths need sheltered lights. Bring %s lanterns for our watch posts.",
  "quest.asterion.queen_beetle.green_watchfires.rewarded": "Their light will guide our scouts. Take a rune for your own path.",
  "quest.asterion.queen_beetle.forgotten_gold.title": "Forgotten Gold",
  "quest.asterion.queen_beetle.forgotten_gold.hint": "Smelt tarnished gold ore.",
  "quest.asterion.queen_beetle.forgotten_gold.accepted": "There is beauty in what the maze has tarnished. Bring %s tarnished gold ingots for my court.",
  "quest.asterion.queen_beetle.forgotten_gold.rewarded": "Time has changed this gold, not diminished it. Accept these emeralds.",
  "quest.asterion.queen_beetle.bronze_promise.title": "Bronze Promise",
  "quest.asterion.queen_beetle.bronze_promise.hint": "Smelt celestial bronze ore.",
  "quest.asterion.queen_beetle.bronze_promise.accepted": "My keepers need a seal that will endure. Bring %s celestial bronze ingots.",
  "quest.asterion.queen_beetle.bronze_promise.rewarded": "Let this seal mark our promise. This rune is a promise in return.",
  "quest.asterion.queen_beetle.queens_covenant.title": "Queen's Covenant",
  "quest.asterion.queen_beetle.queens_covenant.hint": "Smelt celestial gold ore.",
  "quest.asterion.queen_beetle.queens_covenant.accepted": "One final gift will seal our friendship. Bring %s celestial gold ingot for the royal covenant.",
  "quest.asterion.queen_beetle.queens_covenant.rewarded": "The brood knows your kindness. Take these runes; you will always be welcome here.",
