#version 430
layout(local_size_x = 64) in;
layout(std430, binding = 1) readonly buffer PayloadIn { uint payloadIn[]; };
layout(std430, binding = 2) writeonly buffer PayloadOut { uint payloadOut[]; };
layout(std430, binding = 3) buffer Command { uint vertexCount; uint instanceCount; uint rest[]; } cmd;
layout(std430, binding = 4) readonly buffer Scratch { uint slots[]; };
uniform int Count;
uniform int StrideUints;
shared uint groupBase;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationID.x == 0u) {
        uint sum = 0u;
        for (uint g = 0u; g < gl_WorkGroupID.x; g++) sum += slots[uint(Count) + g];
        groupBase = sum;
        if (gl_WorkGroupID.x == gl_NumWorkGroups.x - 1u)
            cmd.instanceCount = sum + slots[uint(Count) + gl_WorkGroupID.x];
    }
    barrier();
    if (i >= uint(Count) || slots[i] == 0u) return;
    uint destination = (groupBase + slots[i] - 1u) * uint(StrideUints);
    uint source = i * uint(StrideUints);
    for (uint word = 0u; word < uint(StrideUints); word++)
        payloadOut[destination + word] = payloadIn[source + word];
}
