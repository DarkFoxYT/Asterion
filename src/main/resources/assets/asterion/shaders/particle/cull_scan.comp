#version 430
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Bounds { vec4 bounds[]; };
layout(std430, binding = 4) buffer Scratch { uint slots[]; };
uniform int Count;
uniform vec4 Planes[6];
shared uint prefix[64];
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lane = gl_LocalInvocationID.x;
    bool visible = i < uint(Count);
    if (visible) {
        vec4 sphere = bounds[i]; // Already camera relative; never truncate large world coordinates.
        for (int p = 0; p < 6; p++)
            if (dot(Planes[p].xyz, sphere.xyz) + Planes[p].w < -sphere.w) visible = false;
    }
    prefix[lane] = visible ? 1u : 0u;
    barrier();
    for (uint offset = 1u; offset < 64u; offset <<= 1u) {
        uint previous = lane >= offset ? prefix[lane - offset] : 0u;
        barrier();
        prefix[lane] += previous;
        barrier();
    }
    if (i < uint(Count)) slots[i] = visible ? prefix[lane] : 0u;
    if (lane == 63u) slots[uint(Count) + gl_WorkGroupID.x] = prefix[63];
}
