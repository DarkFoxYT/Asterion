{
  "schemaVersion": 1,
  "id": "asterion",
  "version": "${version}",
  "name": "Asterion",
  "description": "Asterion 2.0: The Underworld Update. Descend into the living labyrinth, cross death's shale river, and survive the Minotaur at its heart.",
  "authors": [
    "Kronoz",
    "DarkFox"
  ],
  "license": "LicenseRef-AMALGAM-Proprietary",
  "icon": "assets/asterion/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.krodark.asterion.client.AsterionDataGenerator"
    ],
    "client": [
      "net.krodark.asterion.client.AsterionClient"
    ],
    "main": [
      "net.krodark.asterion.Asterion"
    ],
    "modmenu": [
      "net.krodark.asterion.client.AsterionModMenu"
    ],
    "rei_client": [
      "net.krodark.asterion.compat.rei.AsterionReiClientPlugin"
    ],
    "rei_common": [
      "net.krodark.asterion.compat.rei.AsterionReiCommonPlugin"
    ],
    "jade": [
      "net.krodark.asterion.compat.jade.AsterionJadePlugin"
    ]
  },
  "mixins": [
    "asterion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "amnetic": "*",
    "geckolib": ">=5.5.2"
  }
}
