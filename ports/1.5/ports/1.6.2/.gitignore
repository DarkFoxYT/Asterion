# MacOS DS_Store files
.DS_Store

# Gradle cache folder
.gradle

# Gradle build folder
build

# IntelliJ
out/
.idea
*.iml
# mpeltonen/sbt-idea plugin
.idea_modules/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Common working directory
run

# Runtime diagnostics stay local, never in source control.
logs/
*.log
*.log.gz

# Locally assembled release shelf. Keep the manifest, not binary builds.
/modbuilds/*.jar

# Port build adapters and verification tools are required to reproduce these builds.
!tools/
tools/*
!tools/PortMixinSmoke.java
!tools/PortAdvancementSmoke263.java
!tools/prepare-renderer-metadata.py
!tools/verify-extra-ports.py
!tools/port-smoke/
!tools/port-smoke/**

# Keep copied historical research/source assets in the baseline project.
/docs/*
!/docs/STONECUTTER.md
!/docs/INSTALL-MODS.txt
!/docs/authored-catacombs-manifest.json
!/docs/VALIDATION-1.6.2.md
