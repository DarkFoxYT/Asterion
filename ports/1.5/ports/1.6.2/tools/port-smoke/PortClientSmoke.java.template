package net.krodark.asterion.test;

import net.krodark.asterion.Asterion;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.screens.TitleScreen;

/** Test-only entry into a disposable world, then the release's floor/corpse regressions. */
public final class PortClientSmoke {
    private static final long DEADLINE = System.nanoTime() + 480_000_000_000L;
    private static int titleTicks, worldTicks, renderTicks, ticks;
    private static boolean started, prepared;
    private static long nextFrameTick;
    private PortClientSmoke() { }
    // Forge pauses client ticks on some menu screens; render events remain live.
    public static void frame(Minecraft client) {
        long now = System.nanoTime();
        if (now < nextFrameTick) return;
        nextFrameTick = now + 50_000_000L;
        tick(client);
    }
    public static void tick(Minecraft client) {
        try {
            if (++ticks == 1) {
                client.options.pauseOnLostFocus = false;
                client.options.enableVsync().set(false);
                client.options.framerateLimit().set(260);
            }
            if (ticks == 1 || ticks % 20 == 0 && !started)
                Asterion.LOGGER.info("ASTERION_PORT_TICK screen={} overlay={}",
                        client.screen == null ? "none" : client.screen.getClass().getName(),
                        client.getOverlay() == null ? "none" : client.getOverlay().getClass().getName());
            if (System.nanoTime() > DEADLINE) throw new AssertionError("Port smoke timed out");
            if (client.screen instanceof net.minecraft.client.gui.screens.AccessibilityOnboardingScreen) {
                client.options.onboardingAccessibilityFinished();
                client.setScreen(new TitleScreen());
            }
            if (!started && client.screen instanceof TitleScreen && client.getOverlay() == null && ++titleTicks > 20) {
                started = true;
                client.options.pauseOnLostFocus = false;
                client.options.renderDistance().set(4);
                client.options.enableVsync().set(false);
                client.options.framerateLimit().set(260);
                client.options.inactivityFpsLimit().set(net.minecraft.client.InactivityFpsLimit.MINIMIZED);
                client.getWindow().updateVsync(false);
                net.krodark.asterion.AsterionConfig.INSTANCE.cinematicsEnabled = false;
                var settings = __WORLD_SETTINGS__;
                client.createWorldOpenFlows().createFreshLevel("port-smoke-" + System.currentTimeMillis(), settings,
                        new net.minecraft.world.level.levelgen.WorldOptions(321L, false, false),
                        net.minecraft.world.level.levelgen.presets.WorldPresets::createNormalWorldDimensions, new TitleScreen());
            }
            if (client.level == null || client.player == null || client.getSingleplayerServer() == null) return;
            if (Boolean.getBoolean("asterion.textureSmoke")) {
                if (TextureLoadingRegression.tick(client, false)) {
                    net.minecraft.client.Screenshot.grab(client.gameDirectory, "textures-after-reload.png",
                            client.getMainRenderTarget(), 1, message -> Asterion.LOGGER.info("ASTERION_TEXTURE_SCREENSHOT {}", message.getString()));
                    client.stop();
                }
                return;
            }
            if (++worldTicks == 20 && !prepared) {
                prepared = true;
                client.getSingleplayerServer().execute(() -> {
                    try {
                        var player = client.getSingleplayerServer().getPlayerList().getPlayers().getFirst();
                        __FEATURE_CHECK__
                        player.setItemInHand(net.minecraft.world.InteractionHand.MAIN_HAND,
                                new net.minecraft.world.item.ItemStack(Asterion.AFTERBLOW));
                        FloorHotfixRegression.prepare(player);
                        client.getSingleplayerServer().saveEverything(false, true, true);
                    } catch (Throwable failure) { FloorHotfixRegression.failure = failure; }
                });
            }
            if (FloorHotfixRegression.serverPassed && client.level.dimension().equals(Asterion.ASTERION_LEVEL)) {
                client.player.setXRot(35);
                client.player.xRotO = 35;
                if (client.player.getMainHandItem().is(Asterion.AFTERBLOW) && !client.player.isUsingItem())
                    client.player.startUsingItem(net.minecraft.world.InteractionHand.MAIN_HAND);
                if (++renderTicks == 160) {
                    verifySceneResolution(client);
                    net.minecraft.client.Screenshot.grab(client.gameDirectory, "port-smoke.png",
                            client.getMainRenderTarget(), 1, message -> Asterion.LOGGER.info("ASTERION_PORT_SCREENSHOT {}", message.getString()));
                }
            }
            if (!FloorHotfixRegression.serverPassed || renderTicks >= 100)
                FloorHotfixRegression.client(client);
        } catch (Throwable failure) {
            Asterion.LOGGER.error("ASTERION_PORT_SMOKE FAIL", failure);
            client.stop();
            throw new AssertionError("Port smoke failed", failure);
        }
    }

    private static void verifySceneResolution(Minecraft client) throws ReflectiveOperationException {
        var buffersField = net.krodark.asterion.client.render.post.AmneticPostBuffers.class.getDeclaredField("BUFFERS");
        buffersField.setAccessible(true);
        var buffers = (java.util.Map<?, ?>) buffersField.get(null);
        var scene = buffers.get("atmosphere_scene");
        if (scene == null) {
            var registry = com.meekdev.amnetic.client.post.internal.PostEffectRegistry.INSTANCE;
            var entriesField = registry.getClass().getDeclaredField("entries");
            entriesField.setAccessible(true);
            for (var value : (java.util.List<?>) entriesField.get(registry)) {
                var entry = (com.meekdev.amnetic.client.post.internal.PostEffectEntry) value;
                Asterion.LOGGER.info("ASTERION_SHADER_ENTRY {} enabled={} active={} phase={}", entry.getId(), entry.isEnabled(), entry.isActive(), entry.getPhase());
                for (String name : new String[]{"pipeline", "externalTargetSuppliers"}) {
                    var field = entry.getClass().getDeclaredField(name); field.setAccessible(true);
                    var detail = field.get(entry);
                    if (name.equals("pipeline") && detail != null) {
                        for (String part : new String[]{"passes", "targetSpecs"}) {
                            var nested = detail.getClass().getDeclaredField(part); nested.setAccessible(true);
                            Asterion.LOGGER.info("ASTERION_SHADER_DETAIL {} {}={}", entry.getId(), part, nested.get(detail));
                        }
                    } else Asterion.LOGGER.info("ASTERION_SHADER_DETAIL {} {}={}", entry.getId(), name, detail);
                }
            }
            throw new AssertionError("Atmosphere shaders did not render; camera=" + com.meekdev.amnetic.client.camera.AmneticCamera.isReady()
                    + ", coversWorld=" + net.krodark.asterion.client.cinematic.BossFinaleOverlay.coversWorld() + ", buffers=" + buffers.keySet());
        }
        var targetField = scene.getClass().getDeclaredField("target");
        targetField.setAccessible(true);
        var target = (com.mojang.blaze3d.pipeline.RenderTarget) targetField.get(scene);
        var main = client.getMainRenderTarget();
        if (target.width != main.width || target.height != main.height)
            throw new AssertionError("Atmosphere downscaled the world image");
        Asterion.LOGGER.info("ASTERION_SHADER_SHARPNESS PASS scene={}x{}", target.width, target.height);
    }
}
